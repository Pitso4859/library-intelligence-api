# Vercel Container - Library Intelligence API
# Java 17 + Spring Boot 3
# Uses Ubuntu Jammy and an absolute Java path for Vercel's container wrapper.

# ---------- Build stage ----------
FROM maven:3.9.11-eclipse-temurin-17 AS builder
WORKDIR /app

COPY pom.xml ./
RUN mvn -B -q dependency:go-offline

COPY src ./src
RUN mvn -B -q clean package -DskipTests

# ---------- Runtime stage ----------
FROM eclipse-temurin:17-jre-jammy AS runtime
WORKDIR /app

# Run the application as a non-root user.
RUN groupadd --system pitso \
    && useradd --system --gid pitso --home-dir /app --shell /usr/sbin/nologin pitso

COPY --from=builder --chown=pitso:pitso \
    /app/target/pitso-book-system-*.jar /app/app.jar

# Vercel injects a certificate wrapper before the command.  Use an absolute
# Java path and explicit Java library locations so the wrapper cannot lose
# the Temurin runtime through PATH/environment changes.
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/opt/java/openjdk/lib/server:/opt/java/openjdk/lib

# Vercel forwards traffic to $PORT. The Spring configuration reads this value.
ENV PORT=8080
EXPOSE 8080

USER pitso

CMD ["/opt/java/openjdk/bin/java", "-XX:+UseContainerSupport", "-XX:MaxRAMPercentage=70.0", "-Djava.security.egd=file:/dev/./urandom", "-Dserver.address=0.0.0.0", "-jar", "/app/app.jar"]
