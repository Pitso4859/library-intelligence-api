# =============================================
# Vercel Container - Library Intelligence API
# Java 17 + Spring Boot
# =============================================

# ---------- Build stage ----------
FROM eclipse-temurin:17-jdk-alpine AS builder
WORKDIR /app

RUN apk add --no-cache maven

COPY pom.xml ./
RUN mvn dependency:go-offline -q

COPY src ./src
RUN mvn clean package -DskipTests -q

# ---------- Runtime stage ----------
FROM eclipse-temurin:17-jre-alpine AS runtime
WORKDIR /app

RUN addgroup -S pitso && adduser -S pitso -G pitso

COPY --from=builder --chown=pitso:pitso /app/target/pitso-book-system-*.jar /app/app.jar
COPY --chown=pitso:pitso start-vercel.sh /app/start-vercel.sh

RUN chmod +x /app/start-vercel.sh

USER pitso

# Make the Temurin Java runtime explicit for Vercel's container wrapper.
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=/opt/java/openjdk/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/opt/java/openjdk/lib/server:/opt/java/openjdk/lib

# Vercel forwards HTTP traffic to the port in $PORT.
# This is only a safe image default; the runtime value can override it.
ENV PORT=8080
EXPOSE 8080

CMD ["/app/start-vercel.sh"]
